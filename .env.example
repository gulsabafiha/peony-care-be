DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://peony:peony@localhost:5432/peony

MAX_CLAIM_DISTANCE_M=500
DAILY_CLAIM_LIMIT=1
DEFAULT_BROWSE_RADIUS_KM=5

# AWS (SNS SMS when OTP_PROVIDER=sns; S3 media uploads in production only)
# IAM needs at least: s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-1
# Optional CloudFront / custom domain for media URLs (production)
# AWS_S3_CUSTOM_DOMAIN=cdn.peonycare.sg

# OTP provider: console | sns | twilio
OTP_PROVIDER=console
# OTP_SMS_SENDER_ID=MAKANMENU
OTP_EXPIRY_MINUTES=1
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_TOKEN_MAX_AGE_SECONDS=1800
# Twilio Verify (when OTP_PROVIDER=twilio) — never commit real secrets
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# TWILIO_VERIFY_CODE_LENGTH=4
# Play Store reviewers (fixed OTP, SMS skipped). Seed with:
#   python manage.py seed_play_store_review
PLAY_STORE_REVIEW_PHONES=+6599990001,+6599990002
PLAY_STORE_REVIEW_OTP=1234

# PayNow (money donations)
PAYNOW_UEN=
PAYNOW_ACCOUNT_NAME=UduFood Ltd

# Production only
# ALLOWED_HOSTS=api.udufood.com,udufood.com,www.udufood.com,13.62.220.151
# CSRF_TRUSTED_ORIGINS=https://api.udufood.com,https://udufood.com
# CORS_ALLOWED_ORIGINS=https://app.udufood.com
# Use False for plain HTTP (IP:8000); True once HTTPS is terminated in front of the app
# SECURE_SSL_REDIRECT=False
# POSTGRES_PASSWORD=strong-password-here
